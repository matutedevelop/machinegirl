configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    display-drun: "";
    drun-display-format: "{name}";
    disable-history: false;
    hide-scrollbar: true;
    sidebar-mode: false;
    terminal: "kitty";
    font: "Monoid Nerd Font Mono 12";
}

* {
    background: transparent;
    background-alt: transparent;
    foreground: #ffffffee;
    selected: #ffffff20;
    active: #ffffff15;
    urgent: #ff5555aa;
    border-colour: transparent;
    separatorcolor: transparent;
    background-color: transparent;
    text-color: @foreground;
}

window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 550px;
    border: 0;
    border-radius: 16px;
    background-color: #00000066;
}

mainbox {
    padding: 20px;
    spacing: 0px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    padding: 16px 20px;
    margin: 0;
    border: 0;
    border-radius: 12px;
    background-color: #ffffff08;
    children: [ "entry" ];
}

prompt {
    enabled: false;
}

entry {
    placeholder: "search applications...";
    placeholder-color: #ffffff50;
    background-color: transparent;
    text-color: #ffffffee;
    horizontal-align: 0.5;
    cursor: text;
    font: "Monoid Nerd Font Mono 11";
}

listview {
    columns: 1;
    lines: 1;              
    spacing: 6px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    fixed-height: false;   
    fixed-columns: true;
    background-color: transparent;
    margin: 8px 0px 0px 0px;
}

element {
    padding: 12px 16px;
    spacing: 14px;
    border-radius: 10px;
    background-color: transparent;
    cursor: pointer;
}

element normal.normal {
    background-color: transparent;
    text-color: #ffffffd0;
}

element selected.normal {
    background-color: #ffffff20;
    text-color: #ffffffff;
}

element alternate.normal {
    background-color: transparent;
    text-color: #ffffffd0;
}

element-icon {
    size: 32px;
    background-color: transparent;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: none;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    cursor: inherit;
    font: "Monoid Nerd Font Mono 12";
}
