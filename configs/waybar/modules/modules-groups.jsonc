{
    // opening power menu
    "group/power": {
        "orientation": "inherit",
       "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
       },
       "modules": [
            "custom/power",
            "custom/lock",
            "custom/logout",
            "custom/reboot"
       ]
    },

    // only for dual-tone-top theme.
    "group/system": {
       "orientation": "inherit",
       "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "click-to-reveal": true,
            "transition-left-to-right": false
       },

       "modules": [
            "custom/system",
            "custom/cpu-icon",
            "cpu",
            "custom/memory-icon",
            "memory",
            "custom/disk-icon",
            "disk"
       ]
    },

    // system info universal
    "group/sysinfo": {
     "orientation": "inherit",
     "drawer": {
          "transition-duration": 300,
          "children-class": "not-memory",
          "click-to-reveal": true,
          "transition-left-to-right": false
     },

     "modules": [
          "custom/system",
          "cpu",
          "memory",
          "disk",
          "temperature"
     ]
  },

    // internet speed
    "group/network": {
        "orientation": "inherit",
        "drawer": {
             "transition-duration": 300,
             "children-class": "not-memory",
             "transition-left-to-right": false
        },

        "modules": [
             "network",
             "network#speed"
        ]
    },

    // theme and wallpaper
    "group/wall": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },

        "modules": [
            "custom/wallpaper",
            "custom/theme"
        ]
    },


    // others
    "group/power-profiles-daemon": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },

        "modules": [
            "power-profiles-daemon",
            "custom/nightlight", 
            "custom/clipboard", 
        ]
    },


    // Grupo para batería, wifi e iluminación
    "group/system-controls": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": [
            "battery",
            "group/network",
            "backlight"
        ]
    },

    // El grupo de wallpaper y theme ya lo tienes como "group/wall"
    // Solo necesitas mover el "stack" (sysinfo) junto a él
    "group/appearance": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "children-class": "not-memory",
            "transition-left-to-right": false
        },
        "modules": [
            "group/sysinfo",
            "group/wall"
        ]
    },

    "group/audio": {
    "orientation": "horizontal",
    "modules": [
        "pulseaudio",
        "pulseaudio#microphone"
    ]
}


}
